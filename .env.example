# Docker Compose defaults
POSTGRES_DB=cost_review
POSTGRES_USER=cost_review
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://cost_review:change-me@db:5432/cost_review
PREPROCESSING_DIR=/data/preprocessing
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports
UPLOAD_MAX_BYTES=1073741824
UPLOAD_PDF_MAX_BYTES=1073741824
UPLOAD_DWG_MAX_BYTES=524288000
UPLOAD_SPREADSHEET_MAX_BYTES=209715200
UPLOAD_CSV_MAX_BYTES=524288000
PREPROCESSING_MAX_ATTEMPTS=5
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USER_ID=pfc391
NEXT_PUBLIC_PROJECT_ID=project-g5-office
AUTH_REQUIRED=true
# 4개 로컬 계정의 초기 비밀번호. 운영 배포 후 반드시 변경합니다.
MVP_CONSTRUCTION_PASSWORD=1234
MVP_DESIGN_PASSWORD=12345
MVP_PROCUREMENT_PASSWORD=123456
MVP_MASTER_PASSWORD=1234
# 조달청 API 연동 시에만 설정. 값 자체는 DB에 저장하지 않는다.
PRICE_API_URL=
PRICE_API_KEY=
PRICE_API_SERVICE_NAME=PriceInfoService
# 공식 CSV·표준시장단가 파일이 있을 때 API보다 먼저 조회(없으면 비워 둠)
OFFICIAL_PRICE_CSV=
STANDARD_MARKET_PRICE_CSV=
# 타건물 승인 참고단가 CSV 경로(비어 있으면 PREPROCESSING_DIR/15_타건물_기계약단가_참고.csv)
PRICE_REFERENCE_CSV=
